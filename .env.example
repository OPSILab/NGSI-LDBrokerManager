# NGSI-LD Broker Manager standalone stack — environment template.
# Copy to `.env` (git-ignored) and fill in real values.

# --- Server Configuration ---
# Server port (default: 8082)
SERVER_PORT=8082
# Debug mode - set to false in production
SERVER_DEBUG=false

# --- Idra Backend Connection ---
# Base URL to the Idra backend API
# Examples: http://idra:8080 (Docker), http://localhost:8080 (local)
IDRA_BASE_PATH=http://your-idra-host:8080

# --- Context Broker (Orion) Connection ---
# Orion Context Broker hostname/URL
# Examples: orion-ld (Docker service), http://localhost (local)
HOST_ORION=http://your-orion-host
# Orion Context Broker port
PORT_ORION=1026

# --- SSRF Protection ---
# Comma-separated Context Broker hostnames exempt from private-address check
# Required when the Orion broker runs on a Docker network (private IP)
# Examples: CB_URL_ALLOWLIST=orion-ld,orion-ld-SMARTERA-final
CB_URL_ALLOWLIST=
